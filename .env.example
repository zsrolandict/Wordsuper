# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ACCESS_KEY: Required. Shared secret the task pane must send with every AI request.
# Without it the /api endpoints refuse all requests, so strangers can't spend your AI credits.
# At least 16 characters; this placeholder value is refused on purpose.
# Generate a long random value (e.g. `openssl rand -hex 32`) and enter it in the add-in's settings.
APP_ACCESS_KEY="MY_APP_ACCESS_KEY"

# TRUST_PROXY: Which proxies to trust for the client IP (X-Forwarded-For), so the rate limit counts per user.
# A hop count ("1"), "true", or addresses/subnets. Defaults to "1" on Cloud Run, off everywhere else.
# Leave it unset when the server is reached directly, otherwise clients could fake their IP.
# TRUST_PROXY="1"

# AI_PROVIDER: "gemini" (default) uses the Gemini Developer API with GEMINI_API_KEY.
# "vertex" uses Vertex AI in your Google Cloud project, so documents are processed in the chosen region;
# credentials come from the service account (Application Default Credentials), no API key needed.
# AI_PROVIDER="vertex"
# GOOGLE_CLOUD_PROJECT="my-project"
# GOOGLE_CLOUD_LOCATION="europe-west1"

# AI_MODEL: Model name, defaults to gemini-3.8-flash (gemini-2.5-flash is closed to new API keys).
# AI_MODEL="gemini-3.8-flash"

# AI_MODEL_DEEP: Optional stronger model for requests sent with the "Alapos" (deep) thinking setting, e.g. a Pro model.
# Without it, "Alapos" uses AI_MODEL with a high thinking level.
# AI_MODEL_DEEP="gemini-3.8-pro"

# AUDIT_LOG_FILE: Optional. Every AI operation is logged as one JSON line with metadata only (time, user ID from the
# task pane settings, client IP, action, sizes, masking, model, location, status, duration, tokens) - never the
# document text, instructions, answers or recordings. Lines always go to stdout (Cloud Logging on Cloud Run);
# with this set they are appended to the file too.
# AUDIT_LOG_FILE="/var/log/word-writer/audit.jsonl"

# Dictation: by default the task pane transcribes on the user's machine (the recording never leaves it).
# Cloud dictation (/api/transcribe) is always accepted with AI_PROVIDER=vertex and a europe-* (or "eu") location.
# Anywhere else (e.g. the Gemini API) the user has to accept the risk in the task pane settings first; that use is
# written to the audit log. DICTATION_POLICY=eu-only forbids it altogether on this server.
# DICTATION_POLICY="user-risk"

# Masking: by default (required) the server refuses requests the task pane did not mask, so a user who switched
# masking off can't send names and identifiers by mistake. MASKING_POLICY=optional lets users switch it off.
# MASKING_POLICY="required"

# Content Security Policy: the task pane may only connect to this server, Office.js and (for the local dictation
# model) Hugging Face. Only if Word shows a blank or broken pane because of it: CSP="off".
# CSP="on"

# Personal access keys: each colleague gets their own key (at least 16 characters), which can be revoked one by
# one; the audit log then names the key's owner (verified) instead of the name typed in the settings.
# Comma-separated "name:key" pairs. They work next to APP_ACCESS_KEY, or alone without it.
# APP_ACCESS_KEYS="Kovács Anna:anna-hosszu-veletlen-kulcs-1, Nagy Péter:peter-hosszu-veletlen-kulcs-2"

# The firm's styles for the Formázás tab: the file the task pane's "Exportálás (.json)" button saves, put next to
# the server. Everyone sees them among the styles ("Irodai"). OFFICE_STYLES_LOCKED=true makes them the only ones,
# with their values not editable in the pane.
# OFFICE_STYLES_FILE="office-styles.json"
# OFFICE_STYLES_LOCKED="false"
