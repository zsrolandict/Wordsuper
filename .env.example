# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ACCESS_KEY: Required. Shared secret the task pane must send with every AI request.
# Without it the /api endpoints refuse all requests, so strangers can't spend your AI credits.
# At least 16 characters; this placeholder value is refused on purpose.
# Generate a long random value (e.g. `openssl rand -hex 32`) and enter it in the add-in's settings.
APP_ACCESS_KEY="MY_APP_ACCESS_KEY"

# TRUST_PROXY: Which proxies to trust for the client IP (X-Forwarded-For), so the rate limit counts per user.
# A hop count ("1"), "true", or addresses/subnets. Defaults to "1" on Cloud Run, off everywhere else.
# Leave it unset when the server is reached directly, otherwise clients could fake their IP.
# TRUST_PROXY="1"

# AI_PROVIDER: "gemini" (default) uses the Gemini Developer API with GEMINI_API_KEY.
# "vertex" uses Vertex AI in your Google Cloud project, so documents are processed in the chosen region;
# credentials come from the service account (Application Default Credentials), no API key needed.
# AI_PROVIDER="vertex"
# GOOGLE_CLOUD_PROJECT="my-project"
# GOOGLE_CLOUD_LOCATION="europe-west1"

# AI_MODEL: Model name, defaults to gemini-3.8-flash (gemini-2.5-flash is closed to new API keys).
# AI_MODEL="gemini-3.8-flash"

# AUDIT_LOG_FILE: Optional. Every AI operation is logged as one JSON line with metadata only (time, user ID from the
# task pane settings, client IP, action, sizes, masking, model, location, status, duration, tokens) - never the
# document text, instructions, answers or recordings. Lines always go to stdout (Cloud Logging on Cloud Run);
# with this set they are appended to the file too.
# AUDIT_LOG_FILE="/var/log/word-writer/audit.jsonl"

# Dictation: by default the task pane transcribes on the user's machine (the recording never leaves it).
# Cloud dictation (/api/transcribe) is only accepted with AI_PROVIDER=vertex and a europe-* GOOGLE_CLOUD_LOCATION.
